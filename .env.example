# Geheimnisse des ip³ Leitstands. Kopie als .env daneben legen und ausfüllen.
# Die .env gehört nie ins Repo und nie in einen Sync-Ordner.

# Schlüssel zum Signieren serverseitiger Sitzungen. Bei Verlust sind alle Anmeldungen ungültig,
# es passiert aber kein Datenverlust. Neu erzeugen mit:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
IP3_SITZUNG_SCHLUESSEL=bitte-eigenen-zufallswert-eintragen

# Pfad zur Konfiguration, falls sie nicht als config.toml im Projektverzeichnis liegt.
#IP3_CONFIG=D:\ip3-leitstand\config.toml

# Einzelne Konfigurationswerte lassen sich hier überschreiben, Abschnitt und Schlüssel mit
# doppeltem Unterstrich getrennt. Praktisch für die Testinstanz:
#IP3_APP__PORT=8010
#IP3_APP__UMGEBUNG=test

# TimeTac (ab Phase 4, Zugangsdaten beantragt Sven)
#IP3_TIMETAC_CLIENT_ID=
#IP3_TIMETAC_CLIENT_SECRET=
#IP3_TIMETAC_KONTO=
